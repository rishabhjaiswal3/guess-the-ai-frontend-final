VITE_API_BASE_URL=https://api.guesstheai.xyz/api/
VITE_PUBLIC_URL=https://guesstheai.xyz

VITE_NETWORK=mainnet
VITE_CHAIN_ID=16661

VITE_USE_INDEXER_IMAGE=false

// backend apis retry count
VITE_API_RETRY_COUNT=3

// wait time to safely connect socket
VITE_PRESENCE_FRONT_BUFFER_MS=10000

// local storage wait time to call backend
VITE_PRESENCE_QUANTUM_SEC=60

// time to add after in local storage counter
VITE_PRESENCE_TICK_SEC=10

// number of images left to consume when next10 fires
VITE_PREFETCH_THRESHOLD=6

// 0g indexer url for image
# VITE_INDEXER_BASE_URL=https://indexer-storage-turbo.0g.ai/file?root=
VITE_INDEXER_BASE_URL=https://guess-the-ai.sfo3.cdn.digitaloceanspaces.com/game/images/

// number of retries for 0g indexer
VITE_INDEXER_FETCH_RETRIES=3

VITE_PRIVY_APP_ID=cmhfx1cl20001l10d4l0w8u4j
