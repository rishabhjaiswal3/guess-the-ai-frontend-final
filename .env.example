# Privy
VITE_PRIVY_APP_ID=

# Backend API base URL (include trailing /api/)
VITE_API_BASE_URL=http://localhost:3000/api/

# Same manifest storage root as backend IMAGE_LABEL_MANIFEST_STORAGE_ROOT (public; enables profile “direct 0G” verify).
VITE_LABEL_MANIFEST_STORAGE_ROOT=

VITE_INDEXER_BASE_URL=https://indexer-storage-turbo.0g.ai/file?root=

# If browser cannot fetch manifest (e.g. CORS), fall back to POST /verify/image-label (true/false).
VITE_VERIFY_MANIFEST_FALLBACK_SERVER=true

# Network selection: mainnet or testnet
VITE_NETWORK=testnet

# On-chain contract showcase (Wallet tab; backend /api/onchain/config overrides when deployed)
VITE_ONCHAIN_EVENTS_CONTRACT=0x4aCfb1a2Dc270846A7913757189543e4C18F7826
VITE_ONCHAIN_ANSWER_CONTRACT=0x73d377634F906fD24fE342fd95182c3c80bCFe49
VITE_ONCHAIN_LEADERBOARD_CONTRACT=0xDC340Af8b5060Abd8BdA23cCF936ea2FDE3CB3Ce
VITE_TX_EXPLORER_BASE_URL=https://chainscan.0g.ai
